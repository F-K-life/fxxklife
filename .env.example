# Documentation only; set these in your shell. No dotenv dependency is used.
HOST=127.0.0.1
PORT=5056
# Optional server-only OpenAI-compatible provider settings:
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional persistent session secret. A local secret is generated if omitted.
SECRET_KEY=
# Set only behind HTTPS:
COOKIE_SECURE=0
